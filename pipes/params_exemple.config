params {
    
    megahit {
        input_fastq = "/your/clean_reads/path"
        outdir      = "/your/assembly_output/path"

        // stub: nextflow run megahit.nf --input_fastq /your/clean_reads/path --outdir /your/assembly_output_stub/path -stub -profile stub
        // command: nextflow run megahit.nf --input_fastq /your/clean_reads/path --outdir /your/assembly_output/path -resume -bg
    }

    kraken_metaphlan {
        input_assembly = "/your/assembly/path"
        input_fastq    = "/your/clean_reads/path"
        outdir         = "/your/taxonomy_output/path"
        kraken_db      = "/your/kraken2_database/path"
        metaphlan_db   = "/your/metaphlan_database/path"

        // stub: nextflow run kraken_e_metaphlan.nf -c your/config/path --outdir /your/taxonomy_output/path -stub -profile stub
        // command: nextflow run kraken_e_metaphlan.nf -c your/config/path --outdir /your/taxonomy_output/path -resume -bg
    }

    basalt {
        input_assembly = "/your/assembly/path"
        input_fastq = "/your/clean_reads/path"
        outdir = "/your/basalt_output/path"
        conda          = "/your/conda_envs/path/basalt-env"
        
        // stub: nextflow run basalt.nf --input_assembly /your/assembly/path --input_fastq /your/clean_reads/path --outdir /your/basalt_output/path -stub -profile stub
        // command: nextflow run basalt.nf --input_assembly /your/assembly/path --input_fastq /your/clean_reads/path --outdir /your/basalt_output/path -resume -bg
    }   

    prokka_eggnog {
        input      = "/your/basalt_result/path"
        outdir     = "/your/prokka_output/path"
        arq        = "/your/gtdb_results/path/gtdbtk.Samples.ar53.summary.tsv"
        bac        = "/your/gtdb_results/path/gtdbtk.Samples.bac120.summary.tsv"
        eggnog_db  = "/your/eggnog_database/path"
        bins_table = "/your/final_bins_copy/path/final_bins_copy.tsv"
        fa_pattern = "${params.prokka_eggnog.input}/assembly_0"

        // stub: nextflow run prokka_e_eggnog_copy.nf --input /your/basalt_result/path --outdir /your/prokka_output_stub/path -stub -profile stub
        // command: nextflow run prokka_e_eggnog_copy.nf --input /your/basalt_result/path --outdir /your/prokka_output/path -resume -bg
    }

    bakta {
        input      = "/your/basalt_result/path"
        outdir     = "/your/bakta_output/path"
        arq        = "/your/gtdb_results/path/gtdbtk.Samples.ar53.summary.tsv"
        bac        = "/your/gtdb_results/path/gtdbtk.Samples.bac120.summary.tsv"
        eggnog_db  = "/your/eggnog_database/path"
        bakta_db   = "/your/bakta_database/path"
        bins_table = "/your/final_bins_table/path/final_bins.tsv"
        fa_pattern = "${params.bakta.input}/assembly_0"

        // stub: nextflow run bakta.nf --input /your/basalt_result/path --outdir /your/bakta_output_stub/path -stub -profile stub
        // command: nextflow run bakta.nf --input /your/basalt_result/path --outdir /your/bakta_output/path -resume -bg
    }

    gtdbtk {
        input     = "/your/basalt_temp_bins/path"
        outdir    = "/your/gtdbtk_output/path"
        gtdbtk_db = "/your/gtdbtk_database/path"

        // stub: nextflow run GTDBTk.nf -c your/config/path --outdir /your/gtdbtk_output/path -stub -profile stub
        // command: nextflow run GTDBTk.nf -c your/config/path --outdir /your/gtdbtk_output/path -resume -bg
    }

}

